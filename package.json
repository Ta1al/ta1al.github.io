{
  "name": "ta1al-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Quality tooling for Talal Ahmed's Hugo portfolio.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/run-hugo.mjs server --buildDrafts",
    "build": "node scripts/run-hugo.mjs --gc --minify --cleanDestinationDir",
    "test": "node --test .github/scripts/*.test.mjs tests/*.test.mjs",
    "normalize:achievements": "node scripts/normalize-achievements.mjs",
    "validate:data": "node scripts/normalize-achievements.mjs --check && node scripts/validate-data.mjs",
    "validate:site": "node scripts/validate-site.mjs public",
    "lint:js": "eslint assets/js .github/scripts scripts tests",
    "lint:css": "stylelint \"assets/css/**/*.css\"",
    "format:check": "prettier --check package.json eslint.config.js .stylelintrc.json assets/css schemas scripts tests",
    "lint": "npm run lint:js && npm run lint:css && npm run format:check",
    "check": "npm run validate:data && npm test && npm run lint && npm run build && npm run validate:site"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "ajv": "latest",
    "ajv-formats": "latest",
    "eslint": "latest",
    "globals": "latest",
    "html-validate": "^10.17.0",
    "prettier": "latest",
    "smol-toml": "latest",
    "stylelint": "latest",
    "stylelint-config-standard": "latest"
  },
  "engines": {
    "node": ">=22"
  }
}
