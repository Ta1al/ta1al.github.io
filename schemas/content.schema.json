{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ta1al.com/schemas/content.schema.json",
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "stringList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      },
      "uniqueItems": true
    },
    "topicSlug": {
      "enum": [
        "tryhackme",
        "osint",
        "cloud-security",
        "digital-forensics",
        "cybersecurity-learning"
      ]
    },
    "topicList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/topicSlug"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "blogFrontmatter": {
      "type": "object",
      "required": [
        "title",
        "date",
        "lastmod",
        "draft",
        "description",
        "categories",
        "tags",
        "topics",
        "toc"
      ],
      "properties": {
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "date": {
          "type": "string",
          "format": "date-time"
        },
        "lastmod": {
          "type": "string",
          "format": "date-time"
        },
        "draft": {
          "type": "boolean"
        },
        "description": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "categories": {
          "$ref": "#/$defs/stringList"
        },
        "tags": {
          "$ref": "#/$defs/stringList"
        },
        "topics": {
          "$ref": "#/$defs/topicList"
        },
        "series": {
          "$ref": "#/$defs/stringList"
        },
        "toc": {
          "type": "boolean"
        },
        "image": {
          "$ref": "#/$defs/nonEmptyString"
        }
      },
      "additionalProperties": true
    },
    "projectFrontmatter": {
      "type": "object",
      "required": [
        "title",
        "date",
        "description",
        "discipline",
        "status",
        "technologies",
        "featured"
      ],
      "properties": {
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "date": {
          "type": "string",
          "format": "date-time"
        },
        "description": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "discipline": {
          "enum": ["cybersecurity", "software"]
        },
        "status": {
          "enum": ["completed", "in-progress", "maintained", "archived"]
        },
        "technologies": {
          "$ref": "#/$defs/stringList"
        },
        "topics": {
          "$ref": "#/$defs/topicList"
        },
        "featured": {
          "type": "boolean"
        },
        "repository": {
          "anyOf": [{ "const": "" }, { "$ref": "#/$defs/url" }]
        },
        "demo": {
          "anyOf": [{ "const": "" }, { "$ref": "#/$defs/url" }]
        },
        "externalURL": {
          "$ref": "#/$defs/url"
        },
        "aliases": {
          "$ref": "#/$defs/stringList"
        },
        "build": {
          "type": "object",
          "properties": {
            "render": {
              "enum": ["always", "never", "link"]
            },
            "list": {
              "enum": ["always", "local", "never"]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "achievement": {
      "type": "object",
      "required": [
        "id",
        "provider",
        "kind",
        "title",
        "issuer",
        "metrics",
        "showInAll"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "provider": {
          "enum": ["distinctions", "credly", "coursera", "tryhackme"]
        },
        "kind": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "detailTitle": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "issuer": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "subtitle": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "period": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "image": {
          "type": "object",
          "required": ["src", "alt"],
          "properties": {
            "src": {
              "anyOf": [
                { "$ref": "#/$defs/url" },
                {
                  "type": "string",
                  "pattern": "^/images/achievements/[a-f0-9]{16}\\.(avif|jpg|png|svg|webp)$"
                }
              ]
            },
            "alt": {
              "$ref": "#/$defs/nonEmptyString"
            }
          },
          "additionalProperties": false
        },
        "description": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "details": {
          "$ref": "#/$defs/stringList"
        },
        "date": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "metrics": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "value"],
            "properties": {
              "label": {
                "$ref": "#/$defs/nonEmptyString"
              },
              "value": {
                "anyOf": [
                  { "$ref": "#/$defs/nonEmptyString" },
                  { "type": "number" }
                ]
              },
              "format": {
                "enum": ["date"]
              }
            },
            "additionalProperties": false
          }
        },
        "skills": {
          "$ref": "#/$defs/stringList"
        },
        "credential": {
          "type": "object",
          "required": ["url", "label"],
          "properties": {
            "url": {
              "$ref": "#/$defs/url"
            },
            "label": {
              "$ref": "#/$defs/nonEmptyString"
            }
          },
          "additionalProperties": false
        },
        "rarity": {
          "type": "object",
          "required": ["tier", "percent"],
          "properties": {
            "tier": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "percent": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          },
          "additionalProperties": false
        },
        "curated": {
          "type": "boolean"
        },
        "curatedOrder": {
          "type": "integer",
          "minimum": 1
        },
        "showInAll": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "personalAchievement": {
      "type": "object",
      "required": [
        "title",
        "category",
        "institution",
        "degree",
        "period",
        "image",
        "imageAlt",
        "metric",
        "metricLabel",
        "description"
      ],
      "properties": {
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "category": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "institution": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "degree": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "period": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "image": {
          "$ref": "#/$defs/url"
        },
        "imageAlt": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "metric": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "metricLabel": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "description": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "importance": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "facts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "value"],
            "properties": {
              "label": {
                "$ref": "#/$defs/nonEmptyString"
              },
              "value": {
                "$ref": "#/$defs/nonEmptyString"
              }
            },
            "additionalProperties": false
          }
        },
        "url": {
          "$ref": "#/$defs/url"
        },
        "linkLabel": {
          "$ref": "#/$defs/nonEmptyString"
        }
      },
      "additionalProperties": false
    },
    "resume": {
      "type": "object",
      "required": [
        "$schema",
        "basics",
        "work",
        "education",
        "skills",
        "projects",
        "certificates"
      ],
      "properties": {
        "$schema": {
          "type": "string",
          "format": "uri"
        },
        "basics": {
          "type": "object",
          "required": [
            "name",
            "label",
            "email",
            "summary",
            "download",
            "profiles"
          ],
          "properties": {
            "name": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "label": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "email": {
              "type": "string",
              "format": "email"
            },
            "summary": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "download": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "profiles": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["network", "username", "url"],
                "properties": {
                  "network": {
                    "$ref": "#/$defs/nonEmptyString"
                  },
                  "username": {
                    "$ref": "#/$defs/nonEmptyString"
                  },
                  "url": {
                    "$ref": "#/$defs/url"
                  }
                },
                "additionalProperties": true
              }
            }
          },
          "additionalProperties": true
        },
        "work": {
          "type": "array"
        },
        "education": {
          "type": "array"
        },
        "skills": {
          "type": "array"
        },
        "projects": {
          "type": "array"
        },
        "certificates": {
          "type": "array"
        },
        "volunteer": {
          "type": "array"
        }
      },
      "additionalProperties": true
    },
    "integrations": {
      "type": "object",
      "required": ["discord", "tryhackme", "valorant", "analytics", "search"],
      "properties": {
        "discord": {
          "type": "object",
          "required": ["guildId", "widgetUrl", "inviteUrl", "name"],
          "properties": {
            "guildId": {
              "type": "string",
              "pattern": "^[0-9]+$"
            },
            "widgetUrl": {
              "$ref": "#/$defs/url"
            },
            "inviteUrl": {
              "$ref": "#/$defs/url"
            },
            "name": {
              "$ref": "#/$defs/nonEmptyString"
            }
          },
          "additionalProperties": false
        },
        "tryhackme": {
          "type": "object",
          "required": [
            "username",
            "profileUrl",
            "level",
            "badges",
            "rooms",
            "streakDays",
            "rank",
            "topPercent",
            "capability",
            "pointOfView",
            "totalPoints"
          ],
          "properties": {
            "username": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "profileUrl": {
              "$ref": "#/$defs/url"
            },
            "level": {
              "type": "integer",
              "minimum": 0
            },
            "badges": {
              "type": "integer",
              "minimum": 0
            },
            "rooms": {
              "type": "integer",
              "minimum": 0
            },
            "streakDays": {
              "type": "integer",
              "minimum": 0
            },
            "rank": {
              "type": "integer",
              "minimum": 1
            },
            "topPercent": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "capability": {
              "type": "number",
              "minimum": 0
            },
            "pointOfView": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "totalPoints": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "valorant": {
          "type": "object",
          "required": ["accountName", "tag", "region", "endpoint"],
          "properties": {
            "accountName": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "tag": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "region": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "endpoint": {
              "$ref": "#/$defs/url"
            }
          },
          "additionalProperties": false
        },
        "analytics": {
          "type": "object",
          "required": ["googleMeasurementId"],
          "properties": {
            "googleMeasurementId": {
              "type": "string",
              "pattern": "^(|G-[A-Z0-9]+)$"
            }
          },
          "additionalProperties": false
        },
        "search": {
          "type": "object",
          "required": ["googleSiteVerification"],
          "properties": {
            "googleSiteVerification": {
              "$ref": "#/$defs/nonEmptyString"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "valorant": {
      "type": "object",
      "required": [
        "accountName",
        "tag",
        "region",
        "rank",
        "rr",
        "lastMatchRr",
        "shields",
        "iconTier",
        "updatedAt"
      ],
      "properties": {
        "accountName": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "tag": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "region": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "rank": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "rr": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "lastMatchRr": {
          "type": "integer"
        },
        "shields": {
          "type": "integer",
          "minimum": 0
        },
        "iconTier": {
          "type": "integer",
          "minimum": 0,
          "maximum": 27
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    }
  }
}
