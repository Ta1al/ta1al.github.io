---
const particles = Array.from({ length: 80 }, (_, i) => {
  const side = i < 40 ? 'left' : 'right';
  const x = side === 'left'
    ? Math.round(Math.random() * 16 - 6)
    : Math.round(Math.random() * 16 + 90);
  const d = (Math.random() * 4).toFixed(1);
  const s = (2 + Math.random() * 4).toFixed(1);
  return {
    style: `--x:${x};--y:${Math.round(Math.random() * 100)};--d:${d}s;--s:${s}s`,
  };
});
---

<div class="particles" aria-hidden="true">
  {particles.map(p => <div class="particle" style={p.style}></div>)}
</div>

<style>
  .particles {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  .particle {
    position: absolute;
    width: 3px;
    height: 3px;
    background: var(--accent);
    border-radius: 50%;
    opacity: 0.12;
    left: calc(1% * var(--x));
    top: calc(1% * var(--y));
    animation: float var(--s, 3s) ease-in-out var(--d, 0s) infinite alternate;
  }

  @keyframes float {
    0% {
      transform: translateY(0) translateX(0) scale(1);
      opacity: 0.12;
    }
    100% {
      transform: translateY(-24px) translateX(8px) scale(1.5);
      opacity: 0.06;
    }
  }

  @media (max-width: 768px) {
    .particles {
      display: none;
    }
  }
</style>
