---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 — ta1al" description="Page not found.">
  <div class="container">
    <div class="not-found">
      <div class="not-found-terminal">
        <div class="terminal-dots">
          <span class="dot dot--red"></span>
          <span class="dot dot--yellow"></span>
          <span class="dot dot--green"></span>
        </div>
      </div>
      <span class="not-found-prompt">❯</span>
      <h1 class="not-found-code">404</h1>
      <p class="not-found-text">Page not found.</p>
      <a href="/" class="btn btn--primary">Go home</a>
    </div>
  </div>
</BaseLayout>

<style>
  .not-found {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 6rem 0;
  }

  .not-found-terminal {
    display: flex;
    gap: 6px;
    margin-bottom: 1.5rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: rgba(24, 24, 27, 0.5);
  }

  .not-found-prompt {
    font-family: var(--font-mono);
    color: var(--accent);
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
  }

  .not-found-code {
    font-size: 5rem;
    font-weight: 800;
    letter-spacing: -0.04em;
    color: var(--accent);
    margin-bottom: 0.5rem;
    line-height: 1;
    font-family: var(--font-mono);
  }

  .not-found-text {
    font-size: 1.125rem;
    color: var(--text-secondary);
    margin-bottom: 2rem;
  }

  @media (max-width: 640px) {
    .not-found {
      padding: 4rem 0;
    }

    .not-found-code {
      font-size: 3.5rem;
    }
  }
</style>