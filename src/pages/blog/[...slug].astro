---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.filter(p => !p.data.draft).map(p => ({
    params: { slug: p.id },
    props: { post: p },
  }));
}

const { post } = Astro.props;
const { title, description, date, categories } = post.data;
const { Content } = await render(post);
---

<BaseLayout title={`${title} — ta1al`} description={description ?? title}>
  <article class="container blog-post">
    <header class="blog-post-header">
      <div class="blog-post-meta">
        <time datetime={date.toISOString()}>
          {date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
        {categories.length > 0 && (
          <span class="blog-post-categories">
            {categories.map(cat => (
              <span class="blog-post-category">{cat}</span>
            ))}
          </span>
        )}
      </div>
      <h1 class="blog-post-title">{title}</h1>
      {description && <p class="blog-post-description">{description}</p>}
    </header>

    <div class="blog-post-content">
      <Content />
    </div>

    <nav class="blog-post-nav">
      <a href="/blog">&larr; Back to Blog</a>
    </nav>
  </article>
</BaseLayout>

<style>
  .blog-post {
    max-width: 680px;
  }

  .blog-post-header {
    margin-bottom: 2.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
    position: relative;
  }

  .blog-post-header::after {
    content: '';
    position: absolute;
    bottom: -1px;
    left: 0;
    width: 80px;
    height: 2px;
    background: var(--accent);
    box-shadow: 0 0 8px var(--accent);
  }

  .blog-post-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
    flex-wrap: wrap;
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .blog-post-categories {
    display: flex;
    gap: 0.375rem;
  }

  .blog-post-category {
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.125em 0.5em;
    border-radius: 4px;
    background: var(--surface);
    color: var(--accent);
    border: 1px solid var(--border);
  }

  .blog-post-title {
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    margin-bottom: 0.75rem;
  }

  .blog-post-description {
    font-size: 1.0625rem;
    color: var(--text-secondary);
    margin: 0;
  }

  .blog-post-content {
    font-size: 1rem;
    line-height: 1.75;
  }

  .blog-post-content h2 {
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
  }

  .blog-post-content h3 {
    margin-top: 2rem;
    margin-bottom: 0.5rem;
  }

  .blog-post-content p {
    margin-bottom: 1.25rem;
  }

  .blog-post-content ul,
  .blog-post-content ol {
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
    color: var(--text-secondary);
  }

  .blog-post-content li {
    margin-bottom: 0.375rem;
  }

  .blog-post-content blockquote {
    border-left: 3px solid var(--accent);
    padding-left: 1rem;
    margin: 1.5rem 0;
    color: var(--text-secondary);
    font-style: italic;
  }

  .blog-post-content pre {
    margin: 1.5rem 0;
  }

  .blog-post-content img {
    border-radius: var(--radius);
    margin: 1.5rem 0;
    border: 1px solid var(--border);
  }

  .blog-post-content a {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .blog-post-content hr {
    border: none;
    border-top: 1px solid var(--border);
    margin: 2rem 0;
  }

  .blog-post-nav {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .blog-post-nav a {
    font-size: 0.875rem;
    color: var(--text-secondary);
  }

  .blog-post-nav a:hover {
    color: var(--accent);
  }
</style>
