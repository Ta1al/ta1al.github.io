---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogCard from '../../components/BlogCard.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');

const published = allPosts
  .filter(p => !p.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const allCategories = [...new Set(published.flatMap(p => p.data.categories))].sort();
---

<BaseLayout title="Blog — ta1al" description="Thoughts on security, development, and technology.">
  <div class="container">
    <div class="page-head">
      <h1 class="page-title"><span class="page-title-icon">◇</span> Blog</h1>
      <p class="page-subtitle">Thoughts on security, development, and technology.
        <br />Current posts are just placeholders while I work on migrating content and setting up a new writing workflow. Check back soon for real posts!
      </p>
    </div>

    {allCategories.length > 0 && (
      <div class="category-filter" id="category-filter">
        <button class="filter-pill filter-pill--active" data-category="all">All</button>
        {allCategories.map(cat => (
          <button class="filter-pill" data-category={cat}>{cat}</button>
        ))}
      </div>
    )}

    {published.length > 0 ? (
      <div class="blog-list" id="blog-list">
        {published.map(post => (
          <div class="blog-item" data-categories={post.data.categories.join(',')}>
            <BlogCard post={post} />
          </div>
        ))}
      </div>
    ) : (
      <p class="empty-state">No posts yet. Check back soon.</p>
    )}
  </div>
</BaseLayout>

<script>
  const filter = document.getElementById('category-filter');
  const items = Array.from(document.querySelectorAll('#blog-list .blog-item')) as HTMLElement[];

  if (filter instanceof HTMLElement) {
    filter.addEventListener('click', (e) => {
      const target = e.target;
      if (!(target instanceof Element)) return;
      const btn = target.closest('.filter-pill');
      if (!(btn instanceof HTMLElement)) return;

      const category = btn.dataset.category;
      if (!category) return;

      filter.querySelectorAll('.filter-pill').forEach(p => {
        if (p instanceof HTMLElement) p.classList.remove('filter-pill--active');
      });
      btn.classList.add('filter-pill--active');

      items.forEach(item => {
        if (category === 'all') {
          item.style.display = '';
        } else {
          const catsString = item.dataset.categories ?? '';
          const cats = catsString.split(',');
          item.style.display = cats.includes(category) ? '' : 'none';
        }
      });
    });
  }
</script>

<style>
  .page-head {
    margin-bottom: 2rem;
  }

  .page-title {
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    margin-bottom: 0.375rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .page-title-icon {
    color: var(--accent);
    font-size: 0.875rem;
  }

  .page-subtitle {
    color: var(--text-secondary);
  }

  .category-filter {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }

  .filter-pill {
    font-size: 0.8125rem;
    font-weight: 500;
    padding: 0.375em 0.875em;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: transparent;
    color: var(--text-secondary);
    cursor: pointer;
    transition: all 0.2s;
    font-family: inherit;
  }

  .filter-pill:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .filter-pill--active {
    background: var(--accent);
    color: #000;
    border-color: var(--accent);
  }

  .filter-pill--active:hover {
    background: var(--accent-hover);
    color: #000;
    border-color: var(--accent-hover);
  }

  .empty-state {
    text-align: center;
    padding: 4rem 0;
    color: var(--text-muted);
    font-size: 0.9375rem;
  }
</style>
