---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import BlogCard from '../components/BlogCard.astro';
import { getCollection } from 'astro:content';
import projects from '../data/projects.json';

const featuredProjects = projects.filter(p => p.featured).slice(0, 3);
const recentPosts = (await getCollection('blog'))
  .filter(p => !p.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
---

<BaseLayout title="Ta1al — Security Analyst" description="Portfolio and blog of ta1al, a Cybersecurity Analyst and Developer.">
  <div class="container">
    <section class="terminal-hero">
      <div class="terminal-bar">
        <div class="terminal-dots">
          <span class="dot dot--red"></span>
          <span class="dot dot--yellow"></span>
          <span class="dot dot--green"></span>
        </div>
        <span class="terminal-title">portfolio.sh</span>
        <span class="terminal-status">
          <span class="status-dot"></span>
          active
        </span>
      </div>
      <div class="terminal-body">
        <div class="line line--prompt">
          <span class="prompt-symbol">❯</span>
          <span class="prompt-cmd">cat intro.txt</span>
        </div>
        <h1 class="terminal-greeting">
          <span class="greeting-line"><span class="accent-text">Security Analyst</span></span>
          <span class="greeting-line">& Developer</span>
        </h1>
        <div class="line line--output">
          <span class="prompt-symbol">❯</span>
          <span class="prompt-cmd">whoami</span>
        </div>
        <p class="terminal-desc">
          Cybersecurity Analyst based in Pakistan. I analyze security events,
          build detection rules, and develop tools to automate SOC workflows.
          I also share knowledge through blog posts and open-source projects.
        </p>
        <div class="line line--cursor">
          <span class="prompt-symbol">❯</span>
          <span class="cursor-block">_</span>
        </div>
      </div>
    </section>

    {featuredProjects.length > 0 && (
      <section class="section">
        <div class="section-header">
          <h2 class="section-title">
            <span class="section-title-icon">◆</span>
            Featured Projects
          </h2>
          <a href="/projects" class="section-link">View all &rarr;</a>
        </div>
        <div class="project-grid">
          {featuredProjects.map(p => <ProjectCard {...p} url={p.url!} />)}
        </div>
      </section>
    )}

    {recentPosts.length > 0 && (
      <section class="section">
        <div class="section-header">
          <h2 class="section-title">
            <span class="section-title-icon">◇</span>
            Latest Posts
          </h2>
          <a href="/blog" class="section-link">All posts &rarr;</a>
        </div>
        <div class="blog-list">
          {recentPosts.map(post => <BlogCard post={post} />)}
        </div>
      </section>
    )}
  </div>
</BaseLayout>

<style>
  .terminal-hero {
    margin: 1rem 0 0;
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
    background: rgba(24, 24, 27, 0.5);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    transition: border-color 0.4s;
    animation: borderGlow 4s ease-in-out infinite;
  }

  .terminal-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 1rem;
    border-bottom: 1px solid var(--border);
    background: rgba(24, 24, 27, 0.8);
  }

  .terminal-dots {
    display: flex;
    gap: 6px;
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .dot--red { background: #ff5f57; }
  .dot--yellow { background: #febc2e; }
  .dot--green { background: #28c840; }

  .terminal-title {
    font-size: 0.75rem;
    font-family: var(--font-mono);
    color: var(--text-muted);
    margin-left: 0.25rem;
  }

  .terminal-status {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.6875rem;
    font-family: var(--font-mono);
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    animation: statusPulse 2s ease-in-out infinite;
    box-shadow: 0 0 6px var(--accent);
  }

  .terminal-body {
    padding: 1.25rem 1rem;
  }

  .line {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .prompt-symbol {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    flex-shrink: 0;
  }

  .prompt-cmd {
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  .terminal-greeting {
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.03em;
    margin: 0.5rem 0 0.75rem;
    padding-left: 0;
  }

  .greeting-line {
    display: block;
  }

  .accent-text {
    color: var(--accent);
  }

  .line--output {
    margin-top: 1rem;
  }

  .terminal-desc {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin: 0.5rem 0 0;
    padding-left: 1.375rem;
    max-width: 540px;
  }

  .line--cursor {
    margin-top: 0.75rem;
    margin-bottom: 0;
  }

  .cursor-block {
    display: inline-block;
    width: 8px;
    height: 1.1em;
    background: var(--accent);
    animation: cursorPulse 1s step-end infinite;
  }

  .section {
    padding: 3rem 0;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
  }

  .section-title {
    font-size: 1.125rem;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .section-title-icon {
    color: var(--accent);
    font-size: 0.75rem;
  }

  .section-link {
    font-size: 0.8125rem;
    color: var(--text-secondary);
    font-family: var(--font-mono);
    transition: color 0.2s;
  }

  .section-link:hover {
    color: var(--accent);
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1rem;
  }

  .blog-list {
    border-top: 1px solid var(--border);
  }

  @media (max-width: 640px) {
    .terminal-hero {
      margin: 0.5rem 0 0;
      border-radius: 10px;
    }

    .terminal-bar {
      padding: 0.5rem 0.75rem;
    }

    .terminal-body {
      padding: 1rem 0.75rem;
    }

    .terminal-greeting {
      font-size: 1.5rem;
    }

    .prompt-symbol,
    .prompt-cmd {
      font-size: 0.75rem;
    }

    .terminal-desc {
      font-size: 0.875rem;
      padding-left: 1.25rem;
    }

    .section {
      padding: 2rem 0;
    }

    .section-title {
      font-size: 1rem;
    }

    .project-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .terminal-hero {
      animation: none;
    }

    .cursor-block {
      opacity: 1;
      animation: none;
    }

    .status-dot {
      animation: none;
    }
  }
</style>
